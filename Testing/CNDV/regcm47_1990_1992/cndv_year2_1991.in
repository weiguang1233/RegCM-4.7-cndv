 /
 &debugparam
 debug_level = 0,
 /
 &boundaryparam
 nspgx  = 12,
 nspgd  = 12,
 /
 &globdatparam
 ibdyfrq = 6,
 ssttyp = 'ERSST',
 dattyp = 'EIN15',
 calendar = 'gregorian',
 gdate1 = 1991010100,
 gdate2 = 1992010200,
