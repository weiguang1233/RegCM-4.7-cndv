! RegCM4.7-CNDV second full-calendar-year continuation test.
! Continues the accepted 1990 run from 1991-01-01 through 1992-01-01.
 &dimparam
 iy     = 34,
 jx     = 64,
 kz     = 18,
 nsg    = 1,
 /
 &geoparam
 iproj = 'LAMCON',
 ds = 60.0,
 ptop = 5.0,
 clat = 45.39,
 clon = 13.48,
 plat = 45.39,
 plon = 13.48,
 truelatl = 30.0,
 truelath = 60.0,
 i_band = 0,
 /
 &terrainparam
 domname = 'c47yr1990',
 lakedpth = .false.,
 fudge_lnd   = .false.,
 fudge_lnd_s = .false.,
 fudge_tex   = .false.,
 fudge_tex_s = .false.,
